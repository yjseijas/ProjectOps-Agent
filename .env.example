# Copy to .env for local development. Do not put real secrets in this file.
PROJECTOPS_ENV=development
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Leave empty to reuse LLM_API_KEY when both use the same OpenAI account.
EMBEDDING_API_KEY=

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=project-documents

MCP_SERVER_COMMAND=
MCP_SERVER_ARGS=
